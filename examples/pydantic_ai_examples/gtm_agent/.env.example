# Copy to .env and fill in the values you need. Never commit .env.
# Only OPENAI_API_KEY is required to run the agent for real.
# Tests run without any key, using scripted models.

# Model access (required for live runs).
OPENAI_API_KEY=

# Persistence. Leave unset for local SQLite storage.
# Set to a Postgres URL in deployment, for example:
# DATABASE_URL=postgresql://user:password@localhost:5432/gtm_agent
DATABASE_URL=

# Observability. Leave unset to run without Logfire.
LOGFIRE_TOKEN=

# Phase 2 only. The agent does no web search in phase 1.
EXA_API_KEY=

# Service settings.
GTM_WORKSPACE=workspace
PORT=8000
